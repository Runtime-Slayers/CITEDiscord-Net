# =============================================================================
# CITEDiscord-Net .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data (large files — not tracked in git)
data/raw/*.h5
data/raw/*.h5ad
data/processed/*.npz
data/processed/esm2_cache/
data/augmented/

# Model weights (large binary files)
results/*/mvae_best.pt
results/*/cvae_best.pt

# Numpy arrays (large)
results/*/*.npy

# LaTeX auxiliary files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.code-workspace
